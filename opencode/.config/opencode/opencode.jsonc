  },
  "lsp": {
    "typescript": {
      "disabled": true
    },
    "eslint": {
      "disabled": true
    },
    "tsgo": {
      "command": ["bunx", "--bun", "tsgo", "--lsp", "--stdio"],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts"
      ]
    },
    "biome": {
      "command": ["bunx", "--bun", "@biomejs/biome", "lsp-proxy"],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".json",
        ".jsonc",
        ".css",
        ".graphql",
        ".gql",
        ".html"
      ]
    }
  },
  "experimental": {
    "subagent_depth": 3
  },
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" },
    { "action": "provider.use", "resource": "claude-agent", "effect": "allow" },
    { "action": "provider.use", "resource": "github-copilot", "effect": "allow" },
    { "action": "skill.use", "resource": "agent-browser", "effect": "deny" }
  ]
}
