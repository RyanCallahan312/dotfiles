{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": ["@prevalentware/opencode-goal-plugin@latest"],
  "theme": {
    "name": "eldritch-abyss",
    "mode": "system"
  },
  "session": {
    "thinking": "show",
    "sidebar": "hide",
    "scrollbar": false,
    "submit_scroll": "bottom",
    "verbosity": "medium",
    "image_preview": false,
    "new_location": "launch",
    "permissions": "autoaccept"
  },
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "enabled": true,
    "notifications": false,
    "sound": true,
    "volume": 0.30000000000000004
  },
  "tabs": {
    "enabled": false,
    "layout": "horizontal",
    "indicators": "status"
  },
  "animations": true
}
