!.gitkeep
btop/.config/btop/btop.log
/opencode/.config/opencode/skills/skill-creator/scripts/__pycache__
/opencode/.config/opencode/service.json

# Track configuration, not agent-generated state.
/agents/dot-agents/*
!/agents/dot-agents/skills/
/claude/dot-claude/*
!/claude/dot-claude/CLAUDE.md
!/claude/dot-claude/RTK.md
!/claude/dot-claude/settings.json
!/claude/dot-claude/skills/
/claude/dot-claude/skills/.trash/
/claude/dot-claude/skills/synced/
/pi/dot-pi/*
!/pi/dot-pi/agent/
/pi/dot-pi/agent/*
!/pi/dot-pi/agent/models.json
!/pi/dot-pi/agent/settings.json
/agents/dot-agents/skills/**/node_modules/
/agents/dot-agents/skills/**/__pycache__/
/claude/dot-claude/skills/**/node_modules/
/claude/dot-claude/skills/**/__pycache__/
