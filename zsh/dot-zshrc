_eval_cached_init() {
  local cache_file=$1
  shift

  if [[ -f "$cache_file" ]]; then
    source "$cache_file"
  else
    eval "$("$@")"
  fi
}

_bootstrap_omz_if_needed() {
  [[ -r "$ZSH/oh-my-zsh.sh" ]] && return 0
  (( _IS_REAL_INTERACTIVE_ZSH )) || return 1
  [[ -r "$_ZSH_BOOTSTRAP_SCRIPT" ]] || return 1

  print -- "Bootstrapping Oh My Zsh runtime..."
  zsh "$_ZSH_BOOTSTRAP_SCRIPT" || return 1
  [[ -r "$ZSH/oh-my-zsh.sh" ]]
}

for _ssh_cmd in ssh scp sftp rsync; do
  eval "
    ${_ssh_cmd}() {
      _ensure_ssh_agent || return 1
      unfunction ${_ssh_cmd}
      command ${_ssh_cmd} \"\$@\"
    }
  "
done
