_load_deferred_interactive_plugins() {
  (( ${+_DEFERRED_INTERACTIVE_PLUGINS_LOADED} && _DEFERRED_INTERACTIVE_PLUGINS_LOADED )) && return 0

  local plugin_file
  typeset -gi _DEFERRED_INTERACTIVE_PLUGINS_LOADED=1

  for plugin_file in \
    "$_ZSH_CUSTOM_DIR/plugins/zsh-autosuggestions/zsh-autosuggestions.plugin.zsh" \
    "$_ZSH_CUSTOM_DIR/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"
  do
    [[ -r "$plugin_file" ]] && source "$plugin_file"
  done
}

_activate_deferred_interactive_plugins() {
  add-zle-hook-widget -D line-init _activate_deferred_interactive_plugins
  _load_deferred_interactive_plugins
  if zle; then
    zle .reset-prompt
  fi
}

if (( _IS_REAL_INTERACTIVE_ZSH )); then
  autoload -Uz add-zle-hook-widget
  add-zle-hook-widget line-init _activate_deferred_interactive_plugins
fi

refresh_zsh_startup_cache() {
  local cache_dir="$_ZSH_COMPLETION_CACHE_DIR"
  local dump_file file

  mkdir -p "$cache_dir"

  (( $+commands[gh] )) && gh completion -s zsh >| "$cache_dir/_gh"
  (( $+commands[bun] )) && SHELL=zsh bun completions >| "$cache_dir/_bun"

  dump_file="${ZSH_COMPDUMP:-${ZDOTDIR:-$HOME}/.zcompdump-${HOST/.*/}-${ZSH_VERSION}}"
  [[ -n "$dump_file" && (! -f "${dump_file}.zwc" || "$dump_file" -nt "${dump_file}.zwc") ]] && zcompile "$dump_file"

  for file in ~/.cache/mise-init.zsh ~/.cache/zoxide-init.zsh ~/.p10k.zsh "$cache_dir"/_gh "$cache_dir"/_bun; do
    [[ -f "$file" && (! -f "${file}.zwc" || "$file" -nt "${file}.zwc") ]] && zcompile "$file"
  done
}

