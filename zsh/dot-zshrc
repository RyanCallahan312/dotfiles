_ensure_ssh_agent() {
  local agent_sock ssh_add_status=0

  # Keep working inherited/forwarded agents; recover through the shared macOS agent.
  ssh-add -l >/dev/null 2>&1 || ssh_add_status=$?
  if (( ssh_add_status > 1 )); then
    if [[ $OSTYPE == darwin* ]]; then
      agent_sock=$(launchctl asuser "$UID" launchctl getenv SSH_AUTH_SOCK 2>/dev/null) || agent_sock=""
    fi
    if [[ ! -S "$agent_sock" ]]; then
      print -u2 -- "SSH agent unavailable (SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-unset}). Start your system SSH agent and reopen the terminal."
      return 1
    fi

    ssh_add_status=0
    SSH_AUTH_SOCK="$agent_sock" ssh-add -l >/dev/null 2>&1 || ssh_add_status=$?
    if (( ssh_add_status > 1 )); then
      print -u2 -- "Cannot reach the system SSH agent at $agent_sock. Restart your system SSH agent and reopen the terminal."
      return 1
    fi
    export SSH_AUTH_SOCK="$agent_sock"
    unset SSH_AGENT_PID
  fi

  # Never add this machine's private keys to an agent forwarded from another host.
  if [[ -z ${SSH_CONNECTION-} && -r "$HOME/.ssh/github" ]] &&
     { [[ ! -r "$HOME/.ssh/github.pub" ]] || ! ssh-add -T "$HOME/.ssh/github.pub" >/dev/null 2>&1; }; then
    if [[ $OSTYPE == darwin* ]]; then
      ssh-add --apple-use-keychain "$HOME/.ssh/github" || return 1
    else
      ssh-add "$HOME/.ssh/github" || return 1
    fi
  fi
}

